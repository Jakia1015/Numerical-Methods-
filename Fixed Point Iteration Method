#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;
double f(double x, int type) {
    if (type == 1) {
        return (x + 2) / 3;
    }
    else {
        return (cos(x) + 1) / 3;
    }
}

int main() {
    double x, y;
    int type, i = 0;
    
    cout << "Enter equation type: 1.Simple 2.Transcendental (sin, cos etc.): ";
    cin >> type;
    
    if (type == 1) {
        {
            x = 0.5;
        }
    }
    else {
        {
            x = 3.2;
        }
    }
    
    cout << fixed << setprecision(3);
    cout << "iteration\tx\n";
    
    do {
        y = f(x, type);
        cout << i << "\t\t" << y << endl;
        i++;
        if (fabs(y - x) < 0.0001)
            break;
        x = y;
    } while (true);
    
    cout << "\nRoot = " << y;
    return 0;
}
