#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

double f(double x)
{
    return 3 * x - cos(x) - 1;
}

int main()
{
    double a, b, c;
    int i, n;

    cout << "Enter a: ";
    cin >> a;

    cout << "Enter b: ";
    cin >> b;

    cout << "Enter n: ";
    cin >> n;

    if (f(a) * f(b) >= 0)
    {
        cout << "Invalid interval" << endl;
        return 0;
    }

    cout << fixed << setprecision(3);

    cout << "+------+--------+--------+--------+--------+--------+--------+\n";
    cout << "| Step |   a    |   b    |  f(a)  |  f(b)  |   c    |  f(c)  |\n";
    cout << "+------+--------+--------+--------+--------+--------+--------+\n";

    for (i = 1; i <= n; i++)
    {
        c = (a + b) / 2;

        cout << "| " << setw(4) << i
             << " | " << setw(6) << a
             << " | " << setw(6) << b
             << " | " << setw(6) << f(a)
             << " | " << setw(6) << f(b)
             << " | " << setw(6) << c
             << " | " << setw(6) << f(c) << " |\n";

        cout << "+------+--------+--------+--------+--------+--------+--------+\n";

        if (f(a) * f(c) < 0)
            b = c;
        else
            a = c;
    }

    cout << "\nRoot = " << c << endl;

    return 0;
}
